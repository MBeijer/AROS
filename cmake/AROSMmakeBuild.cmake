  list(REMOVE_DUPLICATES _module_mmake_inputs)
  set(MODULE_MMAKE_PARSED_INPUTS "${_module_mmake_inputs}" PARENT_SCOPE)
endfunction()

function(_aros_compiler_builtin_include_dir compiler out_var)
  execute_process(COMMAND "${compiler}" -print-file-name=include
    RESULT_VARIABLE _result OUTPUT_VARIABLE _include_dir
    ERROR_VARIABLE _error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _result EQUAL 0 OR NOT IS_ABSOLUTE "${_include_dir}"
     OR NOT IS_DIRECTORY "${_include_dir}")
    message(FATAL_ERROR "Cannot resolve builtin headers for ${compiler}: ${_include_dir} ${_error}")
  endif()
  set(${out_var} "${_include_dir}" PARENT_SCOPE)
endfunction()

function(_aros_module_compile_args use_base_flags out_var)
  if(NOT _module_compiler_include_dir)
    message(FATAL_ERROR "Resolve the selected compiler's builtin headers before module compilation")
  endif()
  set(_common_compile_args
    "--sysroot=${AROS_SYSROOT}"
    # Explicit SDK -isystem paths otherwise precede GCC's implicit builtin
    # directory, selecting fallback float.h/stddef.h instead of compiler headers.
    -isystem "${_module_compiler_include_dir}"
  )
  if(DEFINED AROS_SOURCE_DIR AND NOT AROS_SOURCE_DIR STREQUAL "")
    list(APPEND _common_compile_args
      "-ffile-prefix-map=${AROS_SOURCE_DIR}/="
      "-fmacro-prefix-map=${AROS_SOURCE_DIR}/="
    )
  endif()
  if(DEFINED AROS_BINARY_DIR AND NOT AROS_BINARY_DIR STREQUAL "")
    list(APPEND _common_compile_args
      "-ffile-prefix-map=${AROS_BINARY_DIR}/="
      "-fmacro-prefix-map=${AROS_BINARY_DIR}/="
    )
  endif()
  list(APPEND _common_compile_args ${_module_config_cppflags})
  if(use_base_flags)
    list(APPEND _common_compile_args ${_module_mmake_user_cppflags})
    list(APPEND _common_compile_args ${_module_mmake_user_includes})
  endif()
  list(APPEND _common_compile_args -D__AROS_GIMME_DEPRECATED__)
  list(APPEND _common_compile_args ${_module_target_isa_cflags})
  list(APPEND _common_compile_args ${_module_target_optimization_cflags})
  list(APPEND _common_compile_args ${_module_target_base_cflags})
  list(APPEND _common_compile_args ${_module_isa_cflags})
  if(use_base_flags)
    list(APPEND _common_compile_args ${_module_mmake_user_cflags})
  endif()
  _aros_get_active_layers(_module_compile_layers)
  get_filename_component(_module_dir_name "${MODULE_PATH}" NAME)
  foreach(_module_compile_layer IN LISTS _module_compile_layers)
    set(_module_layer_dir "${AROS_SOURCE_DIR}/arch/${_module_compile_layer}/${_module_dir_name}")
    if(IS_DIRECTORY "${_module_layer_dir}")
      list(APPEND _common_compile_args "-I${_module_layer_dir}")
    endif()
  endforeach()
  foreach(_include_dir IN LISTS MODULE_INCLUDE_DIRS)
    list(APPEND _common_compile_args "-I${_include_dir}")
  endforeach()
  list(APPEND _common_compile_args "-iquote" "${_module_source_dir}")
  list(APPEND _common_compile_args ${_module_layer_includes})
  list(APPEND _common_compile_args ${_module_layer_cppflags})
  foreach(_define IN LISTS MODULE_COMPILE_DEFINITIONS)
    list(APPEND _common_compile_args "-D${_define}")
  endforeach()
  list(APPEND _common_compile_args ${MODULE_COMPILE_OPTIONS})
  if(use_base_flags)
    list(APPEND _common_compile_args ${_module_base_compile_options})
  endif()
  list(APPEND _common_compile_args ${_module_generated_cppflags})
  list(APPEND _common_compile_args ${_module_generated_cflags})
  list(APPEND _common_compile_args "-I${AROS_NATIVE_INCLUDE_DIR}")
  if(NOT _module_generated_include_root STREQUAL "${AROS_NATIVE_INCLUDE_DIR}")
    list(APPEND _common_compile_args "-I${_module_generated_include_root}")
  endif()
  list(APPEND _common_compile_args "-isystem" "${AROS_NATIVE_INCLUDE_DIR}/aros/posixc")
  list(APPEND _common_compile_args "-isystem" "${AROS_NATIVE_INCLUDE_DIR}/aros/stdc")
  list(APPEND _common_compile_args "-I${MODULE_GENERATED_DIR}")
  list(APPEND _common_compile_args "-I${MODULE_GENERATED_DIR}/include")
  list(APPEND _common_compile_args -include "${_module_deflibdefs}")
  list(APPEND _common_compile_args ${_module_target_safety_cflags})
  set(${out_var} "${_common_compile_args}" PARENT_SCOPE)
endfunction()

function(_aros_merge_source_compile_args common_args source_args out_var)
  set(_includes)
  set(_options)
  set(_include_operand FALSE)
  foreach(_arg IN LISTS source_args)
    if(_include_operand)
      list(APPEND _includes "${_arg}")
      set(_include_operand FALSE)
    elseif(_arg MATCHES "^(-I|-isystem|-iquote|-idirafter)$")
      list(APPEND _includes "${_arg}")
      set(_include_operand TRUE)
    elseif(_arg MATCHES "^(-I|-isystem|-iquote|-idirafter).+")
      list(APPEND _includes "${_arg}")
    else()
      list(APPEND _options "${_arg}")
    endif()
  endforeach()
  if(_include_operand)
    message(FATAL_ERROR "Source include option has no operand: ${source_args}")
  endif()
  # Header search uses first-match precedence; other flags (e.g. -O) use last.
  set(_result ${_includes} ${common_args} ${_options})
  set(${out_var} "${_result}" PARENT_SCOPE)
endfunction()

function(_aros_mmake_uses_kernel_includes includes out_var)
  _aros_read_config_tokens(KERNEL_INCLUDES _kernel_includes)
  set(_uses_kernel_includes FALSE)
  if(_kernel_includes)
    string(FIND ";${includes};" ";${_kernel_includes};" _index)
    if(NOT _index EQUAL -1)
      set(_uses_kernel_includes TRUE)
    endif()
  endif()
  set(${out_var} "${_uses_kernel_includes}" PARENT_SCOPE)
endfunction()

function(_aros_prefer_host_headers args out_var)
  _aros_remove_token_entries(args "-I${AROS_NATIVE_INCLUDE_DIR}")
  _aros_remove_flag_pair(args -I "${AROS_NATIVE_INCLUDE_DIR}")
  _aros_remove_flag_pair(args -isystem "${AROS_NATIVE_INCLUDE_DIR}/aros/posixc")
  _aros_remove_flag_pair(args -isystem "${AROS_NATIVE_INCLUDE_DIR}/aros/stdc")
  list(APPEND args -idirafter "${AROS_NATIVE_INCLUDE_DIR}")
  set(${out_var} "${args}" PARENT_SCOPE)
endfunction()

function(_aros_resolve_source_candidate module_dir basename out_var)
  if(IS_ABSOLUTE "${basename}" AND EXISTS "${basename}")
    set(${out_var} "${basename}" PARENT_SCOPE)
    return()
  endif()

  get_filename_component(_input_ext "${basename}" EXT)
  if(IS_ABSOLUTE "${basename}")
    if(_input_ext)
      set(_candidates "${basename}")
    else()
      set(_candidates)
      foreach(_ext IN ITEMS .c .cc .cxx .cpp .S .s)
        list(APPEND _candidates "${basename}${_ext}")
      endforeach()
    endif()
  elseif(_input_ext)
    set(_candidates "${module_dir}/${basename}")
  else()
    set(_candidates)
    foreach(_ext IN ITEMS .c .cc .cxx .cpp .S .s)
      list(APPEND _candidates "${module_dir}/${basename}${_ext}")
    endforeach()
  endif()

  foreach(_candidate IN LISTS _candidates)
    if(EXISTS "${_candidate}")
      set(${out_var} "${_candidate}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  set(${out_var} "" PARENT_SCOPE)
endfunction()

function(_aros_resolve_layer_source_candidate module_dir source out_var)
  _aros_resolve_source_candidate("${module_dir}" "${source}" _resolved)
  if(NOT _resolved AND NOT IS_ABSOLUTE "${source}")
    # build_archspecific strips object paths; make.cfg also supplies the
    # manifest's source directory as VPATH after the declared source path.
    get_filename_component(_name "${source}" NAME)
    _aros_resolve_source_candidate("${module_dir}" "${_name}" _resolved)
  endif()
  set(${out_var} "${_resolved}" PARENT_SCOPE)
endfunction()

function(_aros_append_ordered_source_spec specs_var source_path)
  if(NOT source_path)
    return()
  endif()
  get_filename_component(_ordered_source_name "${source_path}" NAME)
  set(_ordered_specs "${${specs_var}}")
  list(APPEND _ordered_specs "${_ordered_source_name}|${source_path}")
  set(${specs_var} "${_ordered_specs}" PARENT_SCOPE)
endfunction()

function(_aros_finalize_ordered_source_specs specs_var out_var)
  set(_ordered_specs "${${specs_var}}")
  if(NOT _ordered_specs)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()

  list(REMOVE_DUPLICATES _ordered_specs)
  list(SORT _ordered_specs)

  set(_ordered_sources)
  foreach(_ordered_spec IN LISTS _ordered_specs)
    string(REPLACE "|" ";" _ordered_parts "${_ordered_spec}")
    list(LENGTH _ordered_parts _ordered_len)
    if(_ordered_len LESS 2)
      continue()
    endif()
    list(GET _ordered_parts 1 _ordered_source_path)
    list(APPEND _ordered_sources "${_ordered_source_path}")
  endforeach()

  set(${out_var} "${_ordered_sources}" PARENT_SCOPE)
endfunction()

function(_aros_resolve_module_sources out_var)
  _aros_decode_list(MODULE_BASE_SOURCES)
  _aros_decode_list(MODULE_LAYER_OVERRIDES)
  _aros_decode_list(MODULE_LAYER_ADDITIONS)
  _aros_decode_list(MODULE_LAYER_EXCLUSIONS)
  _aros_decode_list(MODULE_LAYER_MANIFEST_LAYERS)
  if(DEFINED MODULE_RESOLVED_LAYERS AND NOT MODULE_RESOLVED_LAYERS STREQUAL "")
    set(_active_layers "${MODULE_RESOLVED_LAYERS}")
  else()
    _aros_get_active_layers(_active_layers)
  endif()
  get_filename_component(_module_dir_name "${MODULE_PATH}" NAME)

  set(_resolved_arch_source_specs)
  set(_resolved_base_sources)
  set(_base_source_stems)
  foreach(_base_source IN LISTS MODULE_BASE_SOURCES)
    get_filename_component(_base_stem "${_base_source}" NAME_WE)
    list(APPEND _base_source_stems "${_base_stem}")
  endforeach()
  foreach(_base_source IN LISTS MODULE_BASE_SOURCES)
    get_filename_component(_base_stem "${_base_source}" NAME_WE)
    _aros_resolve_source_candidate("${AROS_SOURCE_DIR}/${MODULE_PATH}" "${_base_source}" _resolved)
    if(NOT _resolved)
      message(FATAL_ERROR "Could not resolve base source '${_base_source}' under ${MODULE_PATH}")
    endif()
    set(_resolved_by_manual FALSE)
    foreach(_layer IN LISTS _active_layers)
      foreach(_override IN LISTS MODULE_LAYER_OVERRIDES)
        string(REPLACE ":" ";" _override_parts "${_override}")
        list(LENGTH _override_parts _override_len)
        if(NOT _override_len EQUAL 2)
          message(FATAL_ERROR "Invalid layer override spec: ${_override}")
        endif()
        list(GET _override_parts 0 _override_layer)
        list(GET _override_parts 1 _override_file)
        get_filename_component(_override_stem "${_override_file}" NAME_WE)
        if(_layer STREQUAL _override_layer AND _base_stem STREQUAL _override_stem)
          # build_archspecific replaces objects by basename, even when the
          # base and layer sources live in different relative directories.
          set(_matches "${_base_source_stems}")
          list(LENGTH _matches _base_count)
          list(REMOVE_ITEM _matches "${_base_stem}")
          list(LENGTH _matches _other_count)
          math(EXPR _match_count "${_base_count} - ${_other_count}")
          if(NOT _match_count EQUAL 1)
            message(FATAL_ERROR "Ambiguous base source for layer override ${_override}")
          endif()
          _aros_resolve_layer_source_candidate("${AROS_SOURCE_DIR}/arch/${_layer}/${_module_dir_name}" "${_override_file}" _resolved)
          if(NOT _resolved)
            message(FATAL_ERROR "Could not resolve declared layer override ${_override} for ${MODULE_PATH}")
          endif()
          set(_resolved_by_manual TRUE)
          break()
        endif()
      endforeach()
      if(_resolved_by_manual)
        break()
      endif()
    endforeach()
    if(NOT _resolved_by_manual)
      foreach(_layer IN LISTS _active_layers)
        list(FIND MODULE_LAYER_MANIFEST_LAYERS "${_layer}" _layer_manifest_index)
        if(NOT _layer_manifest_index EQUAL -1)
          continue()
        endif()
        _aros_resolve_source_candidate("${AROS_SOURCE_DIR}/arch/${_layer}/${_module_dir_name}" "${_base_source}" _layer_candidate)
        if(_layer_candidate)
          set(_resolved "${_layer_candidate}")
          break()
        endif()
      endforeach()
    endif()
    set(_resolved_is_layer FALSE)
    string(FIND "${_resolved}" "${AROS_SOURCE_DIR}/arch/" _resolved_arch_index)
    if(_resolved_arch_index EQUAL 0)
      set(_resolved_is_layer TRUE)
      string(FIND "${_resolved}" "${AROS_SOURCE_DIR}/${MODULE_PATH}/" _resolved_module_root_index)
      if(_resolved_module_root_index EQUAL 0)
        set(_resolved_is_layer FALSE)
      endif()
    endif()
    if(_resolved_is_layer)
      _aros_append_ordered_source_spec(_resolved_arch_source_specs "${_resolved}")
    else()
      list(APPEND _resolved_base_sources "${_resolved}")
    endif()
  endforeach()

  foreach(_layer IN LISTS _active_layers)
    list(FIND MODULE_LAYER_MANIFEST_LAYERS "${_layer}" _layer_manifest_index)
    if(NOT _layer_manifest_index EQUAL -1)
      continue()
    endif()
    set(_layer_module_dir "${AROS_SOURCE_DIR}/arch/${_layer}/${_module_dir_name}")
    if(NOT IS_DIRECTORY "${_layer_module_dir}")
      continue()
    endif()

    file(GLOB _layer_source_candidates
      RELATIVE "${_layer_module_dir}"
      "${_layer_module_dir}/*.c"
      "${_layer_module_dir}/*.cc"
      "${_layer_module_dir}/*.cxx"
      "${_layer_module_dir}/*.cpp"
      "${_layer_module_dir}/*.S"
      "${_layer_module_dir}/*.s"
    )
    list(SORT _layer_source_candidates)

    foreach(_layer_source IN LISTS _layer_source_candidates)
      get_filename_component(_layer_source_stem "${_layer_source}" NAME_WE)
      list(FIND _base_source_stems "${_layer_source_stem}" _base_match_index)
      if(NOT _base_match_index EQUAL -1)
        continue()
      endif()
      list(FIND MODULE_LAYER_EXCLUSIONS "${_layer}:${_layer_source}" _excluded_layer_source)
      if(NOT _excluded_layer_source EQUAL -1)
        continue()
      endif()
      _aros_append_ordered_source_spec(_resolved_arch_source_specs "${_layer_module_dir}/${_layer_source}")
    endforeach()
  endforeach()

  foreach(_addition IN LISTS MODULE_LAYER_ADDITIONS)
    string(REPLACE ":" ";" _addition_parts "${_addition}")
    list(LENGTH _addition_parts _addition_len)
    if(NOT _addition_len EQUAL 2)
      message(FATAL_ERROR "Invalid layer addition spec: ${_addition}")
    endif()
    list(GET _addition_parts 0 _addition_layer)
    list(GET _addition_parts 1 _addition_file)
    list(FIND _active_layers "${_addition_layer}" _active_addition_index)
    if(_active_addition_index EQUAL -1)
      continue()
    endif()
    _aros_resolve_layer_source_candidate("${AROS_SOURCE_DIR}/arch/${_addition_layer}/${_module_dir_name}" "${_addition_file}" _addition_path)
    if(NOT _addition_path)
      message(FATAL_ERROR "Could not resolve declared layer addition ${_addition} for ${MODULE_PATH}")
    endif()
    _aros_append_ordered_source_spec(_resolved_arch_source_specs "${_addition_path}")
  endforeach()

  _aros_finalize_ordered_source_specs(_resolved_arch_source_specs _resolved_arch_sources)
  list(REMOVE_DUPLICATES _resolved_base_sources)
  set(_resolved_sources ${_resolved_arch_sources} ${_resolved_base_sources})
  set(${out_var} "${_resolved_sources}" PARENT_SCOPE)
endfunction()

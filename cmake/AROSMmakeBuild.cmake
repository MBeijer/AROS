      separate_arguments(_arg_tokens NATIVE_COMMAND "${_expanded_args}")

      set(_archspec_arch "")
      set(_archspec_mainmmake "")
      set(_archspec_files)
      set(_archspec_asmfiles)
      set(_archspec_linklibfiles)
      set(_archspec_linklibobjs)
      set(_archspec_usesdks)
      set(_pending_list_key "")

      foreach(_arg_token IN LISTS _arg_tokens)

  list(REMOVE_DUPLICATES _module_mmake_arch_usesdks)
  list(REMOVE_DUPLICATES _module_mmake_arch_source_flag_specs)
  if(DEFINED _AROS_MMAKE_VAR_RESIDENT_BEGIN AND NOT "${_AROS_MMAKE_VAR_RESIDENT_BEGIN}" STREQUAL "")
    set(_module_mmake_resident_begin "${_AROS_MMAKE_VAR_RESIDENT_BEGIN}")
  else()
    set(_module_mmake_resident_begin "compiler/libinit/libentry")
  endif()

  set(MODULE_MMAKE_PARSED_FILES "${_module_mmake_files}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_KIND "${_module_mmake_kind}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_COMPILER "${_module_mmake_compiler}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_OUTPUT_NAME "${_module_mmake_output_name}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_OUTPUT_DIR "${_module_mmake_output_dir}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_USER_CPPFLAGS "${_module_mmake_user_cppflags}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_USER_INCLUDES "${_module_mmake_user_includes}" PARENT_SCOPE)

  _aros_remove_empty_entries(_module_mmake_arch_files)
  _aros_remove_empty_entries(_module_mmake_arch_asmfiles)
  _aros_remove_empty_entries(_module_mmake_arch_linklibfiles)
  _aros_remove_empty_entries(_module_mmake_arch_linklibobjs)
  _aros_remove_empty_entries(_module_mmake_arch_usesdks)
  list(REMOVE_DUPLICATES _module_mmake_arch_files)
  list(REMOVE_DUPLICATES _module_mmake_arch_asmfiles)
  list(REMOVE_DUPLICATES _module_mmake_arch_linklibfiles)

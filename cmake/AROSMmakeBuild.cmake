  set(MODULE_MMAKE_PARSED_LINKLIBOBJS "${_module_mmake_linklibobjs}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_USESDKS "${_module_mmake_usesdks}" PARENT_SCOPE)
  set(MODULE_MMAKE_PARSED_ARCH_FILES "${_module_mmake_arch_files}" PARENT_SCOPE)

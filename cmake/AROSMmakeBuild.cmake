        _aros_remove_empty_entries(_module_mmake_user_cppflags)
        _aros_remove_token_entries(_module_mmake_user_cppflags "\\")
      endif()
      if(DEFINED _AROS_MMAKE_VAR_USER_INCLUDES)
        separate_arguments(_module_mmake_user_includes NATIVE_COMMAND "${_AROS_MMAKE_VAR_USER_INCLUDES}")
        _aros_remove_empty_entries(_module_mmake_user_includes)
        _aros_remove_token_entries(_module_mmake_user_includes "\\")
      endif()
      if(DEFINED _AROS_MMAKE_VAR_USER_LDFLAGS)
        separate_arguments(_module_mmake_user_ldflags NATIVE_COMMAND "${_AROS_MMAKE_VAR_USER_LDFLAGS}")
        _aros_remove_empty_entries(_module_mmake_user_ldflags)
